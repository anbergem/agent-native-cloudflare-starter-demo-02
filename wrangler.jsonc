{
  // Worker configuration (docs/plan/03-blueprint.md B14, decisions D02 and D03).
  //
  // We deploy `dist/` as a Worker with static assets, not as a Pages project: the framework's
  // `cloudflare_pages` preset is only used because it is the single-file bundle that boots on
  // workerd (D02). The framework-generated `wrangler.json` is not used.
  //
  // `vars` and `d1_databases` are NOT inherited by environments (F9), so every environment
  // repeats them in full. Secrets are never in this file; use `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acme-ops",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist", "binding": "ASSETS" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_ENV": "local",
    "NODE_ENV": "production",
    "APP_URL": "http://127.0.0.1:8787",
    "AUTO_CREATE_DEFAULT_ORG": "0",
    "AGENT_NATIVE_DISABLE_AUTO_DEV_ACCOUNT": "1",
    // The Cloudflare build replaces `@anthropic-ai/sdk` with
    // `export default class Anthropic {}` (`CLOUDFLARE_WORKER_STUB_MODULES` in
    // core's `deploy/build.js`), so the framework's default `anthropic` engine
    // constructs an empty object and dies on `client.messages.stream` with
    // "Cannot read properties of undefined (reading 'stream')" — agent chat is
    // dead on every Worker, local `dev:worker` included. `ai-sdk:anthropic`
    // reaches the same API over `fetch` through `@ai-sdk/anthropic`, a declared
    // dependency that is bundled intact. Same key, same models.
    // See docs/plan/upstream-issues/anthropic-sdk-stubbed-on-workers.md.
    "AGENT_ENGINE": "ai-sdk:anthropic",
    // `require.resolve` cannot see inside a Worker bundle, so the engine's own
    // "is this package installed?" gate rejects `ai-sdk:*` at runtime with
    // "requires optional packages that are not installed". The framework injects
    // this marker only in its Netlify/Nitro deploy build, so the Cloudflare path
    // has to supply it: a JSON array naming the packages that really are bundled.
    "AGENT_NATIVE_BUILD_ENGINE_PACKAGES": "[\"ai\",\"@ai-sdk/anthropic\"]",
    "AUTH_REQUIRE_EMAIL_VERIFICATION": "0",
    "SEED_ENABLED": "1",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acme-ops-local",
      // Any placeholder works locally: `--local` keys the database by `database_name` (F10).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "acme-ops-staging",
      "vars": {
        "APP_ENV": "staging",
        "NODE_ENV": "production",
        "APP_URL": "https://acme-ops-staging.agent-native-cloudflare-starter.workers.dev",
        "AUTO_CREATE_DEFAULT_ORG": "0",
        "AGENT_NATIVE_DISABLE_AUTO_DEV_ACCOUNT": "1",
        // The native `anthropic` engine cannot load on a Worker (see the
        // top-level `vars`); this one is bundled and reaches the API over fetch.
        "AGENT_ENGINE": "ai-sdk:anthropic",
        "AGENT_NATIVE_BUILD_ENGINE_PACKAGES": "[\"ai\",\"@ai-sdk/anthropic\"]",
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "0",
        "SEED_ENABLED": "1",
        "AGENT_NATIVE_AUDIT_RETENTION_DAYS": "365",
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Recreated 2026-09-16 in Europe. The 2026-09-15 `--location enam`
          // move was made to suit CI and it made the app slow for a European
          // user: the Worker runs in OSL and every query crossed the Atlantic,
          // 260ms for a single health check. Back in Europe that is 92-150ms.
          // It did NOT fix the lost action replies, which reproduce from a
          // laptop against this database too (DISCREPANCIES.md, 2026-09-16).
          // Staging holds only the synthetic scenario, so there is nothing to
          // keep resident; production stays pinned to the EU.
          "database_name": "acme-ops-staging",
          "database_id": "6e9d7a93-dae0-4bc5-a178-70d7d5f976e9",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "acme-ops-production",
      "vars": {
        "APP_ENV": "production",
        "NODE_ENV": "production",
        "APP_URL": "https://acme-ops-production.agent-native-cloudflare-starter.workers.dev",
        "AUTO_CREATE_DEFAULT_ORG": "0",
        "AGENT_NATIVE_DISABLE_AUTO_DEV_ACCOUNT": "1",
        // The native `anthropic` engine cannot load on a Worker (see the
        // top-level `vars`); this one is bundled and reaches the API over fetch.
        "AGENT_ENGINE": "ai-sdk:anthropic",
        "AGENT_NATIVE_BUILD_ENGINE_PACKAGES": "[\"ai\",\"@ai-sdk/anthropic\"]",
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "1",
        // Explicitly disabled rather than omitted: "0" and absent mean the same
        // thing to `env-check`, but only the explicit form survives the
        // uninherited-vars rule in `scripts/lib/wrangler-vars.mjs`.
        "SEED_ENABLED": "0",
        "AGENT_NATIVE_AUDIT_RETENTION_DAYS": "0",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "acme-ops-production",
          "database_id": "a5224873-369a-4560-9c81-cf7aa3d2b354",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
